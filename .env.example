# Backend MySQL Configuration (application-mysql.properties)
SPRING_PROFILES_ACTIVE=mysql
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/campus_placement?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT Security Key (At least 256 bits)
APP_JWT_SECRET=CampusPlacementManagementSystemSuperSecureSecretKeyThatIsAtLeast256BitsLong2026!
APP_JWT_EXPIRATION_MS=86400000

# Server Port
SERVER_PORT=8080

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api

